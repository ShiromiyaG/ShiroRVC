{
    "architecture": "wavehax-v2",
    "learning_rate": 0.0002,
    "betas": [0.8, 0.9],
    "eps": 1e-08,
    "weight_decay": 0.0,
    "lr_scheduler": "cosine annealing epoch",
    "lr_decay": 1.0,
    "lr_final_ratio": 0.1,
